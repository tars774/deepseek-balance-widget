<Window x:Class="DeepSeekBalanceWidget.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · DeepSeek 余额小组件"
        Width="480" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Bg}"
        FontFamily="Segoe UI, Microsoft YaHei"
        TextOptions.TextRenderingMode="ClearType">
    <!--
      设置窗口（4 项必选：API Key / 后台（隐藏时）刷新周期 / 开机自启 / 主题；+ D-19 可选手动余额）。
      主题下拉即时应用并持久化；API Key 保存/清除即写 Credential Manager；
      保存按钮校验并持久化间隔/自启/手动余额（间隔经 Scheduler 即时生效）。
      v1.1：新增「钉住时置顶」开关（§5，即时生效并持久化，默认开）。
      需求变更 2026-10-02：新增「流光效果」一节（开关 + 节奏/强度两组单选，即时生效并持久化，
      默认开/克制/极淡；开关不放托盘菜单）；刷新间隔文案改「后台（隐藏时）刷新周期」语义
      （面板显示期间固定每 5 秒快轮询，与本设置无关，见 Scheduler §4.6）。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,16">

            <TextBlock Text="设置" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Fg}"/>

            <!-- 1. API Key -->
            <TextBlock Text="API Key" FontSize="12" FontWeight="SemiBold" Margin="0,18,0,6"
                       Foreground="{DynamicResource Brush.Fg}"/>
            <PasswordBox x:Name="KeyBox" Height="30" Padding="6,4,6,3" FontSize="12"
                         Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Line}"/>
            <TextBlock x:Name="KeyStateText" FontSize="11" Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.Muted}"
                       Text="未配置（Key 存储于 Windows 凭据管理器，仅本机可读）"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="保存 Key" Width="90" Height="28" Click="SaveKey_Click"/>
                <Button Content="清除 Key" Width="90" Height="28" Margin="8,0,0,0" Click="ClearKey_Click"/>
            </StackPanel>

            <!-- 2. 后台（隐藏时）刷新周期（需求变更 2026-10-02 文案：显示期固定 5s 快轮询与本设置无关） -->
            <TextBlock Text="后台（隐藏时）刷新周期（分钟，5–1440）" FontSize="12" FontWeight="SemiBold" Margin="0,20,0,6"
                       Foreground="{DynamicResource Brush.Fg}"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="IntervalBox" Width="80" Height="28" Padding="6,4,6,3" FontSize="12"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Line}"/>
                <TextBlock Text="默认 30 分钟；面板隐藏时按本周期刷新（失败按 1/5/15 分钟退避）。面板显示期间固定每 5 秒快刷（失败按 5→10→20→40→60 秒退避）"
                           FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Muted}"/>
            </StackPanel>

            <!-- 3. 开机自启 -->
            <TextBlock Text="开机自启" FontSize="12" FontWeight="SemiBold" Margin="0,20,0,6"
                       Foreground="{DynamicResource Brush.Fg}"/>
            <CheckBox x:Name="AutostartBox" Content="登录 Windows 时自动启动（当前用户，HKCU Run）"
                      FontSize="12" Foreground="{DynamicResource Brush.Sub}"/>

            <!-- 4. 主题 -->
            <TextBlock Text="主题" FontSize="12" FontWeight="SemiBold" Margin="0,20,0,6"
                       Foreground="{DynamicResource Brush.Fg}"/>
            <ComboBox x:Name="ThemeBox" Width="160" Height="28" FontSize="12"
                      HorizontalAlignment="Left"
                      SelectionChanged="Theme_SelectionChanged">
                <ComboBoxItem Content="跟随系统"/>
                <ComboBoxItem Content="浅色"/>
                <ComboBoxItem Content="深色"/>
            </ComboBox>

            <!-- 5. 流光效果（需求变更 2026-10-02：开关 + 节奏/强度两组单选，即时生效并持久化） -->
            <TextBlock Text="流光效果" FontSize="12" FontWeight="SemiBold" Margin="0,20,0,6"
                       Foreground="{DynamicResource Brush.Fg}"/>
            <CheckBox x:Name="FlowEnabledBox" FontSize="12" Foreground="{DynamicResource Brush.Sub}"
                      Content="绿条流光：淡白高光带沿进度条从左向右周期扫过（关闭时绿条纯色静止）"
                      Checked="FlowEnabled_Changed" Unchecked="FlowEnabled_Changed"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="节奏" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Sub}"/>
                <RadioButton x:Name="FlowSpeedRestrainedRadio" GroupName="FlowSpeed" Content="克制（默认）"
                             FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.Sub}"
                             Checked="FlowSpeed_Changed"/>
                <RadioButton x:Name="FlowSpeedVisibleRadio" GroupName="FlowSpeed" Content="明显"
                             FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.Sub}"
                             Checked="FlowSpeed_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="强度" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Sub}"/>
                <RadioButton x:Name="FlowIntensityFaintRadio" GroupName="FlowIntensity" Content="极淡（默认）"
                             FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.Sub}"
                             Checked="FlowIntensity_Changed"/>
                <RadioButton x:Name="FlowIntensityVisibleRadio" GroupName="FlowIntensity" Content="可见"
                             FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.Sub}"
                             Checked="FlowIntensity_Changed"/>
            </StackPanel>

            <!-- 6. v1.1：钉住时置顶（即时生效并持久化；默认开） -->
            <TextBlock Text="钉住" FontSize="12" FontWeight="SemiBold" Margin="0,20,0,6"
                       Foreground="{DynamicResource Brush.Fg}"/>
            <CheckBox x:Name="PinTopmostBox" FontSize="12" Foreground="{DynamicResource Brush.Sub}"
                      Content="钉住时置顶：钉住面板后窗口保持在最前（取消后可被其他窗口遮挡）"
                      Checked="PinTopmost_Changed" Unchecked="PinTopmost_Changed"/>

            <!-- 7. D-19 可选：手动余额模式 -->
            <TextBlock Text="手动余额模式（可选）" FontSize="12" FontWeight="SemiBold" Margin="0,20,0,6"
                       Foreground="{DynamicResource Brush.Fg}"/>
            <CheckBox x:Name="ManualBox" FontSize="12" Foreground="{DynamicResource Brush.Sub}"
                      Content="不使用 API Key，手动输入余额（仅本地展示，峰谷功能不受影响）"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBox x:Name="ManualBalanceBox" Width="120" Height="28" Padding="6,4,6,3" FontSize="12"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Line}"/>
                <TextBlock Text="例：110.00" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Muted}"/>
            </StackPanel>

            <!-- 保存 -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Content="保存" Width="90" Height="30" FontWeight="SemiBold" Click="Save_Click"/>
                <Button Content="关闭" Width="90" Height="30" Margin="8,0,0,0" Click="Close_Click"/>
                <TextBlock x:Name="StatusText" Margin="14,0,0,0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource Brush.Acc}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
