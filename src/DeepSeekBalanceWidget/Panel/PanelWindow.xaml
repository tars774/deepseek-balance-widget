<Window x:Class="DeepSeekBalanceWidget.Panel.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek 余额小组件"
        Width="348" Height="258"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI, Microsoft YaHei">

    <!--
      A1 规范（docs/ui-selection.md，硬约束）：面板本体 320×230 / 圆角 14 / 内边距 14,16 / 阴影
      0 10px 26px rgba(15,23,42,.16)。视口 348×258 = 面板 + 四周 14px 阴影余量（探针 A §5.2 做法）。
      布局纵向单列：顶行（胶囊 + 26×26 三圆钮）→ 余额区（顶行下 18px）→ 倒计时+4px 进度条（余额区下 16px）
      → 底行吸底（上次刷新 10px + 节假日降级小图标）。
      v1.1：顶行 2 钮 → 3 钮（图钉居左）。既有视觉规格（320×230/色板/字号/圆钮尺寸）不变；
      设置/刷新两钮保持原相对位置（右端），新增图钉放其左侧——"模式开关"与"动作按钮"分区，
      且不挪动既有按钮（见 docs/ui-selection.md §7）。
      拖动：PanelRoot 上 MouseLeftButtonDown/MouseMove/MouseLeftButtonUp（4px 阈值防误触），
      可交互元素（三圆钮 / 余额点击块 BalanceBlock）不发起拖动（见代码 PanelWindow.IsDragAllowedSource）。
    -->
    <Grid Margin="14">
        <Border x:Name="PanelRoot"
                CornerRadius="14"
                Background="{DynamicResource Brush.Bg}"
                Padding="16,14"
                MouseLeftButtonDown="PanelRoot_MouseLeftButtonDown"
                MouseMove="PanelRoot_MouseMove"
                MouseLeftButtonUp="PanelRoot_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="10" Direction="270"
                                  Opacity="0.16" Color="#0F172A"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 顶行 -->
                    <RowDefinition Height="Auto"/> <!-- 余额区 -->
                    <RowDefinition Height="Auto"/> <!-- 倒计时区 -->
                    <RowDefinition Height="*"/>    <!-- 弹性空隙（吸底） -->
                    <RowDefinition Height="Auto"/> <!-- 底部行 -->
                </Grid.RowDefinitions>

                <!-- 顶行：两端对齐 -->
                <Grid Grid.Row="0">
                    <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                            CornerRadius="999" Padding="13,4"
                            Background="{DynamicResource Brush.AccSoft}">
                        <TextBlock Text="{Binding PillText}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Acc}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- v1.1 图钉钮（置于最左：模式开关与动作按钮分区，既有设置/刷新位置不变）。
                             未钉=描边常态色；已钉=PinGlyph 填充 + 前景 acc（CirclePinButton DataTrigger） -->
                        <Button Style="{StaticResource CirclePinButton}" Click="PinButton_Click">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource PinGlyph}"
                                          Data="M9 3h6v5l2 3v2h-4v7l-1 1-1-1v-7H7v-2l2-3V3z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <!-- A1 §5-5：线性 SVG 造型，2px 描边圆头；常态 Sub 悬停 Acc -->
                        <Button Style="{StaticResource CircleIconButton}" Margin="8,0,0,0" ToolTip="设置" Click="SettingsButton_Click">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Style="{StaticResource FeatherStroke}" Canvas.Left="9" Canvas.Top="9" Width="6" Height="6"/>
                                    <Path Style="{StaticResource FeatherStroke}" Data="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <!-- A1 约定 4：刷新进行中按钮变 AccDeep（DataTrigger），悬停仍为点击反馈 Acc -->
                        <Button Style="{StaticResource CircleRefreshButton}" Margin="8,0,0,0"
                                ToolTip="刷新" Click="RefreshButton_Click">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource FeatherStroke}" Data="M23 4 L23 10 L17 10"/>
                                    <Path Style="{StaticResource FeatherStroke}" Data="M1 20 L1 14 L7 14"/>
                                    <Path Style="{StaticResource FeatherStroke}" Data="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 余额区：顶行下 18px。未配置/Key 无效 → 整块可点击打开设置（A1 约定 1）。
                     v1.1：命名 BalanceBlock——可交互元素，不发起拖动（IsDragAllowedSource 排除） -->
                <Border x:Name="BalanceBlock" Grid.Row="1" Margin="0,18,0,0" Background="Transparent"
                        Cursor="{Binding BalanceCursor}"
                        MouseLeftButtonUp="BalanceBlock_Click">
                    <StackPanel>
                        <TextBlock Text="{Binding BalanceText}"
                                   FontSize="30" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Brush.Fg}"
                                   Visibility="{Binding BalanceNumberVisible, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding BalanceHint}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Brush.Sub}"
                                   Visibility="{Binding BalanceHintVisible, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                    Visibility="{Binding CaptionVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock xml:space="preserve" Text="总  余  额" FontSize="11" Foreground="{DynamicResource Brush.Muted}"/>
                            <!-- A1 §5-5 状态：is_available=false 附加「余额不可调用」提示（非错误） -->
                            <TextBlock xml:space="preserve" Text=" · 余额不可调用" FontSize="10" Margin="6,0,0,0"
                                       Foreground="{DynamicResource Brush.Muted}"
                                       Visibility="{Binding UnavailableVisible, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 倒计时区：余额区下 16px；数字 700/等宽（tabular-nums）防抖动 -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Sub}">
                        <Run xml:space="preserve" Text="{Binding CountdownPrefix, Mode=OneWay}"/>
                        <Run Text="{Binding CountdownText, Mode=OneWay}" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Fg}"
                             Typography.NumeralAlignment="Tabular"/>
                    </TextBlock>
                    <!-- A1 §2 进度条：文字下 8px，高 4px，全圆角，轨道 Line / 填充 Acc -->
                    <Grid Margin="0,8,0,0" Height="4" Background="Transparent">
                        <Border CornerRadius="2" Background="{DynamicResource Brush.Line}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding ProgressFilled, Mode=OneWay}"/>
                                <ColumnDefinition Width="{Binding ProgressRemaining, Mode=OneWay}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="2" HorizontalAlignment="Stretch"
                                    Background="{DynamicResource Brush.Acc}"/>
                        </Grid>
                    </Grid>
                </StackPanel>

                <!-- 底部行：吸底。左侧「上次刷新」10px 极小灰字；右侧节假日降级小图标（A1 约定 3） -->
                <Grid Grid.Row="4" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding LastRefreshLine}"
                               FontSize="10" Foreground="{DynamicResource Brush.Muted}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent"
                                ToolTip="节假日数据不可用，已按周一至周五判断"
                                Visibility="{Binding DegradedVisible, Converter={StaticResource BoolToVis}}">
                        <Viewbox Width="11" Height="11">
                            <Canvas Width="12" Height="12">
                                <Path Data="M6 1.5 L11 10.5 L1 10.5 Z" StrokeThickness="1.3"
                                      StrokeLineJoin="Round" Fill="Transparent"
                                      Stroke="{DynamicResource Brush.Muted}"/>
                                <Path Data="M6 5 L6 7.4" StrokeThickness="1.3" StrokeEndLineCap="Round"
                                      Stroke="{DynamicResource Brush.Muted}"/>
                                <Ellipse Canvas.Left="5.4" Canvas.Top="8.4" Width="1.2" Height="1.2"
                                         Fill="{DynamicResource Brush.Muted}"/>
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
