<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      A1 §3 深色主题完整变量表（acc-soft 为 rgba(...,.14) → alpha 0x24≈36）。
      与 Light.xaml 同键结构，ThemeManager 运行时整字典切换。
    -->
    <Color x:Key="Color.Bg">#1B212C</Color>
    <Color x:Key="Color.Fg">#F1F4F8</Color>
    <Color x:Key="Color.Sub">#A9B2BE</Color>
    <Color x:Key="Color.Muted">#69737F</Color>
    <Color x:Key="Color.Line">#303947</Color>
    <Color x:Key="Color.Card">#242D3A</Color>

    <Color x:Key="Color.AccPeak">#FF9C4A</Color>
    <Color x:Key="Color.AccSoftPeak">#24FF9C4A</Color>
    <Color x:Key="Color.AccDeepPeak">#E4720B</Color>
    <Color x:Key="Color.AccIdle">#46D27F</Color>
    <Color x:Key="Color.AccSoftIdle">#2446D27F</Color>
    <Color x:Key="Color.AccDeepIdle">#17994E</Color>
</ResourceDictionary>
